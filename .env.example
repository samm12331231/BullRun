# Alpaca Paper Trading Credentials
# Get from: https://app.alpaca.markets/paper/dashboard/overview → Paper Trading → API Keys
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# OpenAI API Key (for CIO Agent thesis generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Required to invoke state-changing HTTP endpoints (/api/scan and /api/consent).
# Send this value in the X-API-Key request header.
BULLRUN_API_TOKEN=replace_with_a_long_random_secret

# Alpaca endpoints (don't change for paper trading)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
